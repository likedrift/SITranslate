{
  "manifest_version": 3,
  "name": "Si Translate · 思译",
  "version": "0.1.2",
  "description": "使用你选择的大模型翻译网页与选中文字。按需翻译，轻量、可恢复原文。",
  "minimum_chrome_version": "120",
  "permissions": ["activeTab", "scripting", "storage", "contextMenus"],
  "host_permissions": ["https://*/*", "http://*/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_popup": "popup.html", "default_title": "思译", "default_icon": {"16": "icons/16.png", "32": "icons/32.png"}},
  "icons": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"},
  "options_page": "options.html",
  "commands": {"translate-page": {"suggested_key": {"default": "Alt+Shift+T"}, "description": "翻译当前网页"}, "restore-page": {"suggested_key": {"default": "Alt+Shift+R"}, "description": "恢复当前网页原文"}},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"}
}
